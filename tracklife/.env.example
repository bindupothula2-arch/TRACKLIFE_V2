# Copy to .env (never commit .env)
DATABASE_URL=     # Postgres link from Neon/Supabase, e.g. postgresql://user:pass@host/db?sslmode=require. Leave empty to use local SQLite.
FERNET_KEY=       # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SECRET_KEY=       # any long random text
PSEUDO_KEY=       # any long random text
ANTHROPIC_API_KEY=
